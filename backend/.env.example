# Application identity
RAG_APP_NAME=Enterprise Knowledge RAG
RAG_APP_VERSION=0.1.0

# Runtime: local, test, staging, or production
RAG_ENVIRONMENT=local
RAG_DEBUG=false

# API and logging
RAG_API_V1_PREFIX=/api/v1
RAG_LOG_LEVEL=INFO
RAG_DOCS_ENABLED=true
RAG_REQUEST_ID_HEADER=X-Request-ID
RAG_READINESS_TIMEOUT_SECONDS=2.0

# PostgreSQL. Replace every placeholder locally; never commit real credentials.
RAG_DATABASE_URL=postgresql+psycopg://rag_app:change-me@127.0.0.1:5432/rag1
RAG_TEST_DATABASE_URL=postgresql+psycopg://rag_app_test:change-me@127.0.0.1:5432/rag1_test
RAG_DATABASE_POOL_SIZE=5
RAG_DATABASE_MAX_OVERFLOW=10

# Authentication. Generate at least 32 random bytes for the secret key.
RAG_JWT_SECRET_KEY=replace-with-at-least-64-random-hex-characters
RAG_JWT_ALGORITHM=HS256
RAG_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Immutable source files and document-ingestion safety limits
RAG_OBJECT_STORAGE_PATH=data/objects
RAG_DOCUMENT_UPLOAD_MAX_BYTES=20971520
RAG_DOCUMENT_MAX_CHARACTERS=5000000
RAG_DOCUMENT_PDF_MAX_PAGES=500
RAG_DOCUMENT_DOCX_MAX_UNCOMPRESSED_BYTES=104857600
RAG_INGESTION_MAX_ATTEMPTS=3
RAG_INGESTION_STALE_AFTER_SECONDS=900

# Boundary-aware text chunking. Overlap must be smaller than chunk size.
RAG_CHUNK_SIZE_CHARACTERS=800
RAG_CHUNK_OVERLAP_CHARACTERS=120

# Hybrid retrieval candidate pool and reciprocal-rank-fusion constant
RAG_RETRIEVAL_CANDIDATE_LIMIT=30
RAG_RETRIEVAL_RRF_K=60
RAG_RETRIEVAL_EVIDENCE_MIN_SCORE=0.54

# Alibaba Cloud Model Studio semantic embeddings. Keep the real key in an ignored env file.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
# qwen3.7 may require the region-specific URL shown in your Model Studio workspace.
RAG_DASHSCOPE_BASE_HTTP_API_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1
RAG_DASHSCOPE_WORKSPACE_ID=replace-with-your-workspace-id
RAG_DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_DASHSCOPE_EMBEDDING_DIMENSIONS=1024
RAG_DASHSCOPE_EMBEDDING_BATCH_SIZE=20
RAG_DASHSCOPE_EMBEDDING_TIMEOUT_SECONDS=30
RAG_DASHSCOPE_QUERY_INSTRUCT=Given an enterprise knowledge-base question, retrieve passages that contain the information needed to answer it.
RAG_DASHSCOPE_RERANK_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RAG_DASHSCOPE_RERANK_MODEL=qwen3-rerank
RAG_DASHSCOPE_RERANK_TIMEOUT_SECONDS=30
RAG_DASHSCOPE_RERANK_INSTRUCT=Given an enterprise knowledge-base question, retrieve passages that contain enough evidence to answer it.
RAG_DASHSCOPE_EMBEDDING_COST_CNY_PER_MILLION_TOKENS=0.50
RAG_DASHSCOPE_RERANK_COST_CNY_PER_MILLION_TOKENS=0.50

# DeepSeek generation. Keep the real key in ignored .env.deepseek, never in Git.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_DEEPSEEK_MODEL=deepseek-v4-flash
RAG_DEEPSEEK_TIMEOUT_SECONDS=30
RAG_DEEPSEEK_MAX_OUTPUT_TOKENS=800
RAG_DEEPSEEK_TEMPERATURE=0.1
RAG_DEEPSEEK_PROMPT_CACHE_HIT_COST_USD_PER_MILLION_TOKENS=0.014
RAG_DEEPSEEK_PROMPT_CACHE_MISS_COST_USD_PER_MILLION_TOKENS=0.44
RAG_DEEPSEEK_OUTPUT_COST_USD_PER_MILLION_TOKENS=1.32
RAG_ANSWER_CONTEXT_MAX_CHARACTERS=12000

# Bounded retries and circuit breakers for embedding, reranking, and generation.
RAG_EXTERNAL_RETRY_MAX_ATTEMPTS=3
RAG_EXTERNAL_RETRY_BASE_DELAY_SECONDS=0.25
RAG_EXTERNAL_RETRY_MAX_DELAY_SECONDS=2
RAG_EXTERNAL_CIRCUIT_FAILURE_THRESHOLD=5
RAG_EXTERNAL_CIRCUIT_RECOVERY_SECONDS=30

# Runtime hardening. The local cache and limiter are process-local until Redis is deployed.
RAG_RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT_WINDOW_SECONDS=60
RAG_RATE_LIMIT_DEFAULT_REQUESTS=120
RAG_RATE_LIMIT_AUTH_REQUESTS=10
RAG_RATE_LIMIT_ANSWER_REQUESTS=20
RAG_EMBEDDING_CACHE_ENABLED=true
RAG_EMBEDDING_CACHE_MAX_ENTRIES=512
RAG_EMBEDDING_CACHE_TTL_SECONDS=300

# Prometheus metrics. Set a random 32+ character token outside local-only environments.
RAG_METRICS_ENABLED=true
RAG_METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
